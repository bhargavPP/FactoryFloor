{
  "Jwt": {
    "Secret": "your-super-secret-key-minimum-32-characters-long!",
    "Issuer": "FactoryFloor",
    "Audience": "FactoryFloor"
  },
  "ReverseProxy": {
    "Routes": {
      "identity-route": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/api/auth/{**catch-all}" }
        ]
      },
      "machine-route": {
        "ClusterId": "machine-cluster",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/machines/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/api/machines/{**catch-all}" }
        ]
      },
      "telemetry-route": {
        "ClusterId": "telemetry-cluster",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/telemetry/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "identity-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://identity-service:80"
          }
        }
      },
      "machine-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://machine-service:80"
          }
        }
      },
      "telemetry-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://telemetry-service:80"
          }
        }
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}